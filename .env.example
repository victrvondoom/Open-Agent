# PayProof configuration. Everything is optional: with nothing set, the app runs fully
# offline on synthetic fixtures with deterministic fallbacks (and says so in the UI).
# Never commit real credentials.

# Server
PORT=8360
HOST=127.0.0.1

# NVIDIA Nemotron via Meterless Nightshift (local OpenAI-compatible endpoint) ...
# LLM_PROVIDER=nightshift
# LLM_BASE_URL=http://localhost:<nightshift-port>/v1
# ... or via the NVIDIA API catalog
# LLM_PROVIDER=nvidia
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=
LLM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
LLM_TIMEOUT_S=25

# Meterless engine (advisory scenario ranking; HTTP contract unverified)
# METERLESS_URL=http://localhost:<port>
# METERLESS_ENGINE=world-model

# Zetaris federated query endpoint (allowlisted SQL templates only)
# ZETARIS_URL=http://localhost:3000/api
# ZETARIS_TOKEN=
