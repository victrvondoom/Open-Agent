# PayProof configuration — placeholders only, never commit real values.
# With nothing set the app runs fully offline (SAMPLE_MODE behaviour): local synthetic
# fixtures, the in-process Meterless World Model, and a deterministic narrator.

# Runtime
SAMPLE_MODE=false          # true = force fixtures + deterministic narrator, no network
PORT=8360
HOST=127.0.0.1             # use 0.0.0.0 inside Docker

# Zetaris — documented direct REST route (Management -> API Tokens / Organisation in the Zetaris UI)
ZETARIS_REST_URL=          # e.g. http://localhost:8888/api/v1.0
ZETARIS_API_KEY=your-zetaris-api-key
ZETARIS_ORG_ID=            # numeric organisation ID
ZETARIS_DATABASE=payproof  # Lightning database created by docs/zetaris/register.sql
ZETARIS_TIMEOUT_S=15

# NVIDIA Nemotron — https://integrate.api.nvidia.com/v1 (keys from build.nvidia.com start with nvapi-)
NVIDIA_API_KEY=your-nvidia-api-key
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b   # copy the exact id from build.nvidia.com; check with run.py --check-integrations
LLM_TIMEOUT_S=25
# Any other OpenAI-compatible endpoint serving Nemotron (optional; overrides the NVIDIA default):
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_PROVIDER=
